# .gitignore
# Cobre os 3 sub-projetos (horta-backend, HortaFirmware, horta-app)

# ---------- Node.js (backend e app) ----------
node_modules/
npm-debug.log*
.npm/

# ---------- Backend ----------
horta-backend/data/db.json

# ---------- PlatformIO (firmware) ----------
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ---------- Expo / React Native (app) ----------
.expo/
horta-app/dist/
horta-app/web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ---------- Sistema operacional ----------
.DS_Store
Thumbs.db

# ---------- Variáveis de ambiente / segredos ----------
.env
.env.local
